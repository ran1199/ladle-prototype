# Copy this file to .env.local and fill in the values for local testing.
# Never commit .env.local. On Vercel, set these under Project → Settings → Environment Variables.

# Anthropic API key (from console.anthropic.com). Server only. Needed from Milestone 6.
ANTHROPIC_API_KEY=
# Claude model ID used by the AI routes, e.g. a current Claude Sonnet model.
ANTHROPIC_MODEL=
# Comma-separated access codes that unlock Live AI, e.g. code-one,code-two
LIVE_ACCESS_CODES=
# Max AI calls per access code per day (default 60).
LIVE_DAILY_LIMIT=
# Link for the "Read the case study" button. Leave empty to hide the button.
CASE_STUDY_URL=
